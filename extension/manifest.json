{
  "manifest_version": 3,
  "name": "超星微信学习助手",
  "description": "监控超星课程视频，支持微信远程答题、学习解析、题目截图和错题记录。",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://chaoxing.com/*",
    "*://*.chaoxing.com/*",
    "*://xueyinonline.com/*",
    "*://*.xueyinonline.com/*",
    "*://xuexi365.com/*",
    "*://*.xuexi365.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chaoxing.com/*",
        "*://*.chaoxing.com/*",
        "*://xueyinonline.com/*",
        "*://*.xueyinonline.com/*",
        "*://xuexi365.com/*",
        "*://*.xuexi365.com/*"
      ],
      "js": [
        "content/state.js",
        "content/runtime.js",
        "content/video.js",
        "content/quiz-extraction.js",
        "content/image-rendering.js",
        "content/remote-commands.js",
        "content/weixin-delivery.js",
        "content/answer-state.js",
        "content/remote-bridge.js",
        "content/quiz-panel.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "超星微信学习助手"
  }
}

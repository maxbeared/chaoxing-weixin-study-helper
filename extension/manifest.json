{
  "manifest_version": 3,
  "name": "Chaoxing Weixin Study Helper",
  "description": "Monitor Chaoxing course videos, support Weixin remote answers, explanations, screenshots, and wrong-question tracking.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chaoxing Weixin Study Helper"
  }
}
